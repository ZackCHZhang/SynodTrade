# Copy to .env and fill in. The real .env must never be committed.
# Secrets are read from the environment only — never put them in configs/ or code.

# ---- Safety -------------------------------------------------------------------
# Live trading requires BOTH `mode: live` in the pipeline config AND this set to 1.
QUANT_ALLOW_LIVE=0

# ---- Database -----------------------------------------------------------------
POSTGRES_USER=quant
POSTGRES_PASSWORD=change-me
POSTGRES_DB=quant
POSTGRES_PORT=5432
QUANT_DATABASE_URL=postgresql+asyncpg://quant:change-me@localhost:5432/quant

# ---- IBKR (TWS / IB Gateway socket API, NOT the Client Portal Web API) --------
# Paper ports: IB Gateway 4002, TWS 7497.  Live ports: IB Gateway 4001, TWS 7496.
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=17
IBKR_ACCOUNT=DU0000000
# Used only by the ib-gateway docker container (phase 10)
TWS_USERID=
TWS_PASSWORD=

# ---- LLM (referenced by api_key_env in configs/llm_providers.yaml) ------------
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# ---- Sentiment sources --------------------------------------------------------
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=quant-system/0.1 by u/your_username
STOCKTWITS_ACCESS_TOKEN=
